# =============================================================================
# ARC environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in the values you
# actually need. Anything you leave blank or comment out is treated as "not
# configured" — features that depend on it will silently disable themselves
# and the rest of training will continue normally.
#
#   cp .env.example .env
#   $EDITOR .env
#
# train.py auto-loads `.env` at startup via python-dotenv.
# =============================================================================


# --- OpenRouter (worker LLM, API mode) ---------------------------------------
# Required when you pass `--api`. Sign up + grab a key at https://openrouter.ai/.
# Leave blank if you only run the local HuggingFace worker (`--hf-model ...`).
OPENROUTER_API_KEY=sk-or-...

# Default OpenRouter model used when `--api-model` is omitted on the CLI.
# Any OpenRouter model id works (e.g. `openai/gpt-4o-mini`,
# `anthropic/claude-3.5-sonnet`, `qwen/qwen-2.5-7b-instruct`).
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct


# --- CUDA (optional override) ------------------------------------------------
# train.py defaults this to "0". Set explicitly here if you want to pin a
# different GPU on this machine.
# CUDA_VISIBLE_DEVICES=0
